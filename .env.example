# Personal Linear dashboard — create a key at https://linear.app/settings/api
LINEAR_API_KEY=

# Optional (default 3001)
# DASHBOARD_PORT=3001

# Local static prototype served by `npm run dev` (default 37689).
# `npm run dashboard` starts it automatically unless the port is already in use.
# LOCAL_PROTOTYPE_PORT=37689
# SKIP_PROTOTYPE_SERVER=1
